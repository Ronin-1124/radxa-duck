#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    if ! getent passwd radxa-duck >/dev/null; then
        adduser --system --group --home /var/lib/radxa-duck --no-create-home --quiet radxa-duck
    fi
    for group in audio video render; do
        if getent group "$group" >/dev/null; then
            adduser --quiet radxa-duck "$group"
        fi
    done
    install -d -o radxa-duck -g radxa-duck -m 0700 /var/lib/radxa-duck
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        deb-systemd-helper enable radxa-duck.service >/dev/null
        deb-systemd-invoke restart radxa-duck.service
    fi
fi
